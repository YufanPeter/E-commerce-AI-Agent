# CartPilot text-only experiment baseline.
# Copy this file to .env and replace placeholders locally. Never commit .env.

# General OpenAI-compatible chat model (required for Router and Composer smoke tests)
ARK_API_KEY=replace_with_chat_api_key
ARK_MODEL=replace_with_chat_model_id
ARK_BASE_URL=https://replace-with-chat-endpoint.example.com/v1

# Text embedding endpoint (required for index build and retrieval smoke tests)
# If the same credential and base URL are used, these key/base-url fields may be omitted.
ARK_EMBEDDING_API_KEY=replace_with_embedding_api_key
ARK_EMBEDDING_MODEL=replace_with_embedding_model_id
ARK_EMBEDDING_BASE_URL=https://replace-with-embedding-endpoint.example.com/v1

# Chroma collection paired with the embedding model above.
# Rebuild this directory from scratch whenever the endpoint, model, or vector dimension changes.
CHROMA_PERSIST_DIR=backend/storage/chroma_phase_a_embedding3
CHROMA_COLLECTION=product_knowledge_embedding3_phase_a

# Step 0 baseline policy: keep hybrid retrieval enabled and reranking disabled.
# This matches CartPilot_AI_PM_最终方案.md; later experiments must record overrides.
USE_HYBRID=1
USE_RERANK=0

# Optional runtime controls.
ARK_TIMEOUT=30
ARK_MAX_RETRIES=1
LOG_LEVEL=INFO

# Optional reranker configuration. Leave unset while USE_RERANK=0.
# ZHIPU_API_KEY=replace_with_rerank_api_key
# RERANK_MODEL=replace_with_rerank_model_id
# RERANK_BASE_URL=https://replace-with-rerank-endpoint.example.com/rerank
