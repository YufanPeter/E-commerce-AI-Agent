# ===================== 对话 / 意图 / 看图：Chat 大模型 =====================
# 三家都兼容 OpenAI 协议；LLM_PROVIDER 选主服务，其余配了 key 的自动成为 fallback。
#
# 路线 A（推荐，只需一个百炼 key）：百炼托管的 DeepSeek —— LLM_PROVIDER=dashscope，
#   DASHSCOPE_MODEL=deepseek-v4.1-flash（文本 / function calling），
#   DASHSCOPE_VISION_MODEL=qwen3-vl-plus（看图更快）。向量 / 精排本来就在百炼，一个 key 全包。
# 路线 B：DeepSeek 官方 API —— LLM_PROVIDER=deepseek + DEEPSEEK_API_KEY，deepseek-flash 文本 + 图片一个模型；
#   向量 / 精排仍需百炼 key（DeepSeek 没有 embedding 接口）。
LLM_PROVIDER=dashscope

# DeepSeek 官方（路线 B 时填；申请：https://platform.deepseek.com/api_keys）
# DEEPSEEK_API_KEY=替换为你的_DeepSeek_API_Key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# DEEPSEEK_FAST_MODEL=   # 官方 API 目前只有 flash / v4-pro，一般留空
# 思考模式开关（开了首字会慢几秒）；要开设为 1
DEEPSEEK_THINKING=0
DEEPSEEK_TIMEOUT=30

# 阿里云百炼 Chat（路线 A 的主服务；DASHSCOPE_API_KEY 同时给下面的 embedding 用）
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=deepseek-v4.1-flash
DASHSCOPE_VISION_MODEL=qwen3-vl-plus
# 分级模型：路由 / query 解析 / 多需求拆解 / 购物车动作分发只要结构化输出，用更快的 qwen-flash；话术仍用 DASHSCOPE_MODEL。留空则全用 DASHSCOPE_MODEL
DASHSCOPE_FAST_MODEL=qwen-flash
# 话术 / 商品解说可换更强的模型（实测 deepseek-v4-pro 首字约 2.5s，v4.1-flash 约 0.6s）；留空则用 DASHSCOPE_MODEL
# DASHSCOPE_COMPOSER_MODEL=deepseek-v4-pro
# 百炼上 deepseek-* / qwen3-* 默认开思考，这里统一关掉（enable_thinking=false）；要开设为 1
DASHSCOPE_THINKING=0

# 豆包 Chat（可选 fallback）
# ARK_API_KEY=替换为你的豆包_API_Key
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/
# ARK_MODEL=替换为你的豆包_endpoint_id

# 主服务失败后的熔断冷却（秒）：网络/超时类 30s，401/404 类 300s。冷却期内直接走 fallback，不再白等。
LLM_FAIL_COOLDOWN=30
LLM_HARD_FAIL_COOLDOWN=300
# LLM 结果缓存 TTL（秒）：首轮路由 / query 解析 / 多需求拆解 / 话术 / 查询向量。0 关闭。
LLM_CACHE_TTL=600
# router 跑的同时并行预取 query 解析与拆解（省掉串行等待）。0 关闭。
LLM_PREFETCH=1

# ===================== 向量 / 精排：仍走阿里云百炼（DeepSeek 没有 embedding 接口） =====================
# 文本 RAG 与拍照找货共用同一个多模态向量空间
DASHSCOPE_API_KEY=替换为你的百炼_API_Key
DASHSCOPE_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding
DASHSCOPE_EMBEDDING_DIMENSIONS=2048
DASHSCOPE_EMBEDDING_BATCH_SIZE=20

# 百炼文本精排（主服务）；完全关闭精排时设置 USE_RERANK=0
DASHSCOPE_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1/reranks
DASHSCOPE_RERANK_MODEL=qwen3-rerank
USE_RERANK=1
DASHSCOPE_TIMEOUT=30
DASHSCOPE_MAX_RETRIES=1

# 豆包多模态向量 fallback（可选）
# ARK_EMBEDDING_API_KEY=替换为你的豆包_embedding_API_Key
# ARK_EMBEDDING_MODEL=替换为你的豆包_embedding_endpoint_id

# 智谱 Rerank fallback（可选）
# ZHIPU_API_KEY=替换为你的智谱_API_Key
# RERANK_MODEL=rerank
# RERANK_BASE_URL=https://open.bigmodel.cn/api/paas/v4/rerank

BACKEND_BASE_URL=http://127.0.0.1:8000
